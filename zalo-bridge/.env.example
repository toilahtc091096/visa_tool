# Cổng HTTP của bridge (Python gọi POST /send vào đây)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3100
# Phải trùng ZALO_BRIDGE_SECRET bên .env của Python
ZALO_BRIDGE_SECRET=change-me
# Python server nhận tin nhắn (POST /zalo/inbound)
PYTHON_BASE_URL=http://127.0.0.1:10000
# Chỉ chuyển tin của các nhóm này (cách nhau dấu phẩy); để trống = mọi nhóm
TRACKER_ZALO_GROUP_ID=
ZALO_CREDENTIALS_PATH=credentials.json
ZALO_QR_PATH=qr.png
