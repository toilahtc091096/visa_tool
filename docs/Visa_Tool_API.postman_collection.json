    {
      "name": "Lưu trữ R2",
      "item": [
        {
          "name": "Upload image",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/r2/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "r2",
                "images"
              ]
            },
            "description": "mode=upload: đẩy ảnh lên R2 bằng file hoặc image_base64. Có thể chỉ định key đầy đủ, hoặc folder + filename.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "mode",
                  "type": "text",
                  "value": "upload",
                  "description": "upload | presign"
                },
                {
                  "key": "folder",
                  "type": "text",
                  "value": "E05111310",
                  "description": "Folder đích"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Ảnh cần upload"
                },
                {
                  "key": "filename",
                  "type": "text",
                  "value": "passport.jpg",
                  "description": "Tên file (tùy chọn)",
                  "disabled": true
                },
                {
                  "key": "key",
                  "type": "text",
                  "value": "",
                  "description": "Key đầy đủ thay cho folder+filename",
                  "disabled": true
                },
                {
                  "key": "content_type",
                  "type": "text",
                  "value": "image/jpeg",
                  "description": "MIME (tùy chọn)",
                  "disabled": true
                },
                {
                  "key": "image_base64",
                  "type": "text",
                  "value": "",
                  "description": "Gửi ảnh dạng base64 thay cho file",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Presign URL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/r2/images",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "r2",
                "images"
              ]
            },
            "description": "mode=presign: tạo URL ký sẵn (upload_url, method PUT) để client tự upload file thẳng lên R2 với đúng Content-Type, trong thời hạn expires_in (tối thiểu 60s).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "mode",
                  "type": "text",
                  "value": "presign",
                  "description": "upload | presign"
                },
                {
                  "key": "key",
                  "type": "text",
                  "value": "E05111310/passport.jpg",
                  "description": "Key object"
                },
                {
                  "key": "content_type",
                  "type": "text",
                  "value": "image/jpeg",
                  "description": "MIME"
                },
                {
                  "key": "expires_in",
                  "type": "text",
                  "value": "900",
                  "description": "Thời hạn URL (giây)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete object(s)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/r2/images/delete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "r2",
                "images",
                "delete"
              ]
            },
            "description": "Xóa một object theo key, hoặc mọi object theo prefix (ví dụ {\"prefix\": \"E05111310/\"}).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"E05111310/passport.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Get object",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/r2/images/get?key=E05111310/passport.jpg&download=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "r2",
                "images",
                "get"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "E05111310/passport.jpg",
                  "description": "Key object"
                },
                {
                  "key": "download",
                  "value": "false",
                  "description": "true = tải về"
                }
              ]
            },
            "description": "Lấy nội dung một file trên R2. download=true trả về dạng file đính kèm."
          },
          "response": []
        },
        {
          "name": "Download folder (zip)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/r2/folders/download?prefix=E05111310/&scan=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "r2",
                "folders",
                "download"
              ],
              "query": [
                {
                  "key": "prefix",
                  "value": "E05111310/",
                  "description": "Folder trên R2"
                },
                {
                  "key": "scan",
                  "value": "false",
                  "description": "true = xử lý như scan (South)"
                }
              ]
            },
            "description": "Tải cả folder R2 thành .zip. scan=true: làm phẳng ảnh giấy tờ như máy scan (chỉ miền Nam). Header trả về: X-R2-File-Count, X-R2-Total-Size, X-Scan-Applied."
          },
          "response": []
        }
      ]
    },
