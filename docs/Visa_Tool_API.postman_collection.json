            "url": {
              "raw": "{{baseUrl}}/upload-html-to-pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload-html-to-pdf"
              ]
            },
            "description": "Render file .html thành PDF (WeasyPrint) rồi upload lên R2 vào folderName. Trả về file_key.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "File .html"
                },
                {
                  "key": "folderName",
                  "type": "text",
                  "value": "E05111310",
                  "description": "Folder đích trên R2"
                }
              ]
